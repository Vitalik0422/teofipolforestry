{
  "name": "teofipolforestry-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "api",
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:client",
    "dev:api": "npm --workspace api run start:dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace api run build && npm --workspace client run build",
    "lint": "npm --workspace api run lint && npm --workspace client run lint",
    "test": "npm --workspace api run test"
  },
  "dependencies": {
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "axios": "^1.20.0",
    "leaflet": "^1.9.4",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22"
  }
}
